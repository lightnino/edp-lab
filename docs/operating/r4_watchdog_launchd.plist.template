<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.edp-lab.r4-watchdog-fixture</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PINNED_PYTHON__</string>
    <string>-m</string>
    <string>edp_lab.operating.watchdog_delivery_r4</string>
    <string>__OWNER_PROTECTED_CONFIG__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PYTHONPATH</key><string>__PINNED_RUNTIME_SRC__</string></dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__OWNER_PROTECTED_LOG_DIR__/watchdog.stdout.log</string>
  <key>StandardErrorPath</key><string>__OWNER_PROTECTED_LOG_DIR__/watchdog.stderr.log</string>
</dict>
</plist>
